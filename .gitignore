.claude/
gocraft-linux-amd64
gocraft-windows-amd64.exe
*.exe
examples/go-plugin/bin/
# `go build` with no -o names the binary after the directory.
examples/go-plugin/go-plugin

# Plugin bundles (.gcpkg files) dropped in by the admin.
# The README is tracked, so use the wildcard pattern instead of plugins/ to
# allow the negation rule below to work.
plugins/*
!plugins/README.md

# Worlds and state written by a running server
world/
world_nether/
world_end/
logs/latest.log
logs/*.log.gz
ops.json
permissions.json
whitelist.json
banned-players.json
banned-ips.json
