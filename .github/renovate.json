{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "github-actions": {
    "enabled": true
  },
  "gomod": {
    "enabled": true
  },
  "packaeRules": [
    {
      "matchManagers": [
        "*"
      ],
      "groupName": "Weekly Dependencies Update"
    }
  ],
  "timezone": "America/New_York",
  "schedule": [
    "on sunday"
  ]
}
